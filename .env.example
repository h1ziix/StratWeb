STRATWEB_ENVIRONMENT=development
STRATWEB_HOST=127.0.0.1
STRATWEB_PORT=8000
# Keep runtime data outside synced folders (OneDrive/Dropbox):
# sync conflicts can corrupt DuckDB files.
STRATWEB_DATA_DIR=./data
# Used when a CLI command does not pass --db.
STRATWEB_DUCKDB_PATH=./data/stratweb.duckdb
STRATWEB_MAP_OVERVIEW_DIR=./data/map_overviews
STRATWEB_MAX_UPLOAD_BYTES=2147483648
STRATWEB_POSITION_SAMPLE_INTERVAL_TICKS=16
# One active DB writer plus this many waiting imports.
STRATWEB_IMPORT_QUEUE_SIZE=4
STRATWEB_PARSER_TIMEOUT_SECONDS=1800
STRATWEB_PARSER_MEMORY_LIMIT_BYTES=4294967296
STRATWEB_IMPORT_MINIMUM_FREE_DISK_BYTES=2147483648
STRATWEB_IMPORT_CANCEL_GRACE_SECONDS=5
# Enables the non-persistent calibration workbench and candidate-transform endpoint.
STRATWEB_MAP_DEVELOPER_MODE=false
# Optional local-only integration fixture; never commit the referenced .dem file.
# STRATWEB_TEST_DEMO=C:\path\to\match.dem
